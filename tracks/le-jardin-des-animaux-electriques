<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- PAS DIT AAN: titel, beschrijving en definitieve URL van de trackpagina -->
  <title>Le Jardin des Animaux Electriques | Lyrop</title>
  <meta name="description" content="Listen to Le Jardin des Animaux Electriques by Lyrop on your preferred music service.">
  <link rel="canonical" href="https://lyropmusic.com/tracks/le-jardin-des-animaux-electriques/">

  <!-- Voor een mooie preview op WhatsApp, Instagram, LinkedIn, enz. -->
  <meta property="og:type" content="music.song">
  <meta property="og:site_name" content="Lyrop">
  <meta property="og:title" content="le-jardin-des-animaux-electriques — Lyrop">
  <meta property="og:description" content="Listen now on Spotify, Apple Music, Bandcamp, SoundCloud or YouTube Music.">
  <meta property="og:url" content="https://lyropmusic.com/tracks/le-jardin-des-animaux-electriques/">
  <meta property="og:image" content="https://lyropmusic.com/tracks/le-jardin-des-animaux-electriques/cover.jpg">
  <meta property="og:image:alt" content="Cover artwork for Le Jardin des Animaux Electriques by Lyrop">
  <meta name="twitter:card" content="summary_large_image">

  <style>
    :root {
      color-scheme: dark;
      --background: #09090b;
      --surface: rgba(255, 255, 255, 0.055);
      --surface-hover: rgba(255, 255, 255, 0.105);
      --border: rgba(255, 255, 255, 0.12);
      --text: #f5f2ed;
      --muted: #aaa6a0;
      --accent: #d9bd88;
      --shadow: 0 30px 80px rgba(0, 0, 0, 0.48);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      min-height: 100vh;
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at 50% -10%, rgba(95, 77, 112, 0.42), transparent 42rem),
        linear-gradient(145deg, #111014 0%, var(--background) 55%, #050506 100%);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.19;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
      mix-blend-mode: soft-light;
    }

    a { color: inherit; }

    .page {
      position: relative;
      width: min(100% - 32px, 760px);
      margin: 0 auto;
      padding: 32px 0 48px;
    }

    .brand {
      display: block;
      width: fit-content;
      margin: 0 auto 26px;
      color: var(--text);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.34em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .card {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 26px;
      background: var(--surface);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .cover-wrap {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #19181b;
    }

    .cover {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cover-wrap::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 22%;
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.38));
      pointer-events: none;
    }

    .content { padding: clamp(24px, 5vw, 42px); }

    .eyebrow {
      margin: 0 0 9px;
      color: var(--accent);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.15rem, 7.2vw, 4.2rem);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }

    .artist {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 1.05rem;
      letter-spacing: 0.06em;
    }

    .intro {
      max-width: 58ch;
      margin: 24px 0 28px;
      color: #c9c5bf;
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .player {
      margin-bottom: 30px;
      overflow: hidden;
      border-radius: 12px;
      background: #181818;
    }

    .player iframe {
      display: block;
      width: 100%;
      height: 152px;
      border: 0;
    }

    .listen-label {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .services {
      display: grid;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .service-link {
      display: flex;
      min-height: 60px;
      align-items: center;
      gap: 14px;
      padding: 13px 16px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.035);
      text-decoration: none;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .service-link:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.27);
      background: var(--surface-hover);
    }

    .service-link:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }

    .service-icon {
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
      object-fit: contain;
    }

    .service-name {
      flex: 1;
      font-size: 0.98rem;
      font-weight: 650;
    }

    .action {
      color: var(--muted);
      font-size: 0.78rem;
    }

    .arrow {
      color: var(--accent);
      font-size: 1.15rem;
      line-height: 1;
    }

    footer {
      padding: 24px 10px 0;
      color: #74716d;
      font-size: 0.75rem;
      text-align: center;
    }

    footer a {
      text-underline-offset: 3px;
    }

    @media (min-width: 700px) {
      .page { padding-top: 50px; }
      .card { border-radius: 32px; }
      .cover-wrap { aspect-ratio: 16 / 12; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</head>

<body>
  <main class="page">
    <a class="brand" href="https://lyropmusic.com/" aria-label="Lyrop home">Lyrop</a>

    <article class="card">
      <div class="cover-wrap">
        <!-- Zet cover.jpg in dezelfde map als dit HTML-bestand -->
        <img class="cover" src="cover.jpg" alt="Cover artwork for TRACK TITLE by Lyrop" width="1600" height="1600">
      </div>

      <div class="content">
        <p class="eyebrow">New release</p>
        <h1>TRACK TITLE</h1>
        <p class="artist">Lyrop</p>

        <!-- Optioneel: vervang dit door 1 à 2 zinnen over de track, of verwijder het hele blok -->
        <p class="intro">
          A cinematic journey through electronic textures, shifting rhythms and unexpected turns.
        </p>

        <div class="player" aria-label="Spotify player">
          <!--
            PAS DIT AAN:
            Open de track in Spotify > Delen > Songlink kopiëren.
            In https://open.spotify.com/track/ABC123 is ABC123 je SPOTIFY_TRACK_ID.
          -->
          <iframe
            title="Listen to TRACK TITLE by Lyrop on Spotify"
            src="https://open.spotify.com/embed/track/SPOTIFY_TRACK_ID?utm_source=generator&theme=0"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>

        <p class="listen-label">Listen on</p>

        <!-- PAS DE VIJF href-URL'S HIERONDER AAN -->
        <ul class="services" aria-label="Music services">
          <li>
            <a class="service-link" href="https://open.spotify.com/track/SPOTIFY_TRACK_ID" target="_blank" rel="noopener noreferrer">
              <img class="service-icon" src="https://cdn.simpleicons.org/spotify/1ED760" alt="" width="28" height="28">
              <span class="service-name">Spotify</span>
              <span class="action">Play</span><span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="service-link" href="https://lyrop.bandcamp.com/track/TRACK-SLUG" target="_blank" rel="noopener noreferrer">
              <img class="service-icon" src="https://cdn.simpleicons.org/bandcamp/1DA0C3" alt="" width="28" height="28">
              <span class="service-name">Bandcamp</span>
              <span class="action">Buy / play</span><span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="service-link" href="https://music.apple.com/ALBUM-OR-TRACK-URL" target="_blank" rel="noopener noreferrer">
              <img class="service-icon" src="https://cdn.simpleicons.org/applemusic/FA243C" alt="" width="28" height="28">
              <span class="service-name">Apple Music</span>
              <span class="action">Play</span><span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="service-link" href="https://soundcloud.com/LYROP/TRACK-SLUG" target="_blank" rel="noopener noreferrer">
              <img class="service-icon" src="https://cdn.simpleicons.org/soundcloud/FF5500" alt="" width="28" height="28">
              <span class="service-name">SoundCloud</span>
              <span class="action">Play</span><span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="service-link" href="https://music.youtube.com/watch?v=VIDEO_ID" target="_blank" rel="noopener noreferrer">
              <img class="service-icon" src="https://cdn.simpleicons.org/youtubemusic/FF0033" alt="" width="28" height="28">
              <span class="service-name">YouTube Music</span>
              <span class="action">Play</span><span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </article>

    <footer>
      © <span id="year"></span> Lyrop · <a href="https://lyropmusic.com/">lyropmusic.com</a>
    </footer>
  </main>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
